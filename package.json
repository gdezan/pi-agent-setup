{
  "name": "@gdezan/pi-agent-setup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portable personal Pi resources and a selective, machine-local installer",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gdezan/pi-agent-setup.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "node setup.mjs",
    "link": "node setup.mjs --link",
    "test": "node --test scripts/*.test.mjs",
    "test:resources": "node --experimental-strip-types --test dotfiles/extensions/pi-cache-observer/*.test.ts dotfiles/extensions/pi-footer/sections/*.test.ts dotfiles/extensions/tests/*.test.ts dotfiles/local-packages/ask-user-question/tests/*.test.ts && npm run test:footer-render",
    "test:footer-render": "node --experimental-strip-types dotfiles/extensions/pi-footer/footer.render-check.ts",
    "test:wizard": "python3 -B scripts/toolkit-wizard.test.py",
    "test:utility-tui": "python3 -B scripts/utility-model-tui.test.py"
  },
  "files": [
    "dotfiles/extensions",
    "dotfiles/local-packages",
    "dotfiles/skills"
  ],
  "pi": {
    "extensions": [
      "./dotfiles/extensions/pi-footer/index.ts",
      "./dotfiles/extensions/model-tiers.ts",
      "./dotfiles/extensions/provider-usage.ts",
      "./dotfiles/extensions/session-autoname.ts",
      "./dotfiles/extensions/pi-cache-observer/index.ts",
      "./dotfiles/local-packages/ask-user-question/index.ts",
      "./dotfiles/extensions/next-prompt/index.ts"
    ],
    "skills": [
      "./dotfiles/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@clack/prompts": "1.8.0",
    "diff": "8.0.4",
    "semver": "7.8.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0"
  }
}
