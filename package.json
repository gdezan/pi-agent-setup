{
  "name": "@gdezan/pi-gd",
  "version": "1.0.0",
  "private": true,
  "description": "Portable personal Pi resources and a selective, machine-local installer",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gdezan/pi-gd.git"
  },
  "files": [
    "extensions"
  ],
  "type": "module",
  "scripts": {
    "setup": "node setup.mjs",
    "link": "node setup.mjs --link",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "node --test scripts/*.test.mjs",
    "test:resources": "node --experimental-strip-types --test extensions/pi-cache-observer/*.test.ts extensions/pi-footer/sections/*.test.ts extensions/tests/*.test.ts extensions/pi-ask-user-question/tests/*.test.ts && npm run test:footer-render",
    "test:footer-render": "node --experimental-strip-types extensions/pi-footer/footer.render-check.ts",
    "test:wizard": "python3 -B scripts/toolkit-wizard.test.py",
    "test:utility-tui": "python3 -B scripts/utility-model-tui.test.py"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "diff": "9.0.0",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-footer/index.ts",
      "./extensions/pi-favorites-cycle/index.ts",
      "./extensions/pi-provider-usage/index.ts",
      "./extensions/pi-session-autoname/index.ts",
      "./extensions/pi-cache-observer/index.ts",
      "./extensions/pi-ask-user-question/index.ts",
      "./extensions/pi-next-prompt/index.ts"
    ]
  }
}
